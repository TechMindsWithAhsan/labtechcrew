# Copy to .env.local and fill in. Never commit .env.local.

# --- Environment -----------------------------------------------------------
# robots.ts returns "Disallow: /" unless this is "production" (or VERCEL_ENV is).
# This guard exists because shipping a staging noindex to production is
# catastrophic AND silent. On launch day, fetch the production robots.txt and
# grep five rendered pages for "noindex" BEFORE you celebrate.
NEXT_PUBLIC_SITE_ENV=development

# --- Database --------------------------------------------------------------
# Leave blank locally — the site builds and renders without it.
MONGODB_URI=

# --- Lead notification (blueprint §6.4) ------------------------------------
# Target: a human reply in under 5 minutes during business hours.
# Email alone will not achieve that. Point LEAD_WEBHOOK_URL at a Slack
# incoming webhook or a WhatsApp relay so a phone actually buzzes.
# Where lead emails are DELIVERED.
LEAD_NOTIFY_EMAIL=labtechcrew65@gmail.com

# Who lead emails are SENT AS.
# ⚠️ Leave this BLANK to start. The code then uses Resend's sandbox sender
# (onboarding@resend.dev), which needs zero DNS setup but can ONLY deliver to
# the address that owns the Resend account. So: create the Resend account with
# labtechcrew65@gmail.com and testing works on the first try.
# Once labtechcrew.com is verified in Resend, set this to:
#   LEAD_FROM_EMAIL=LabTechCrew <leads@labtechcrew.com>
# and you can then deliver to any address, including the business inbox.
LEAD_FROM_EMAIL=

RESEND_API_KEY=

# Makes a phone actually buzz. Email alone will not hit a 5-minute reply.
# A Slack incoming webhook is the fastest thing to set up here.
LEAD_WEBHOOK_URL=

# --- Bot defence -----------------------------------------------------------
# Not optional before you run paid traffic.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Analytics -------------------------------------------------------------
# Leave blank until the consent policy and privacy page are live.
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_META_PIXEL_ID=
